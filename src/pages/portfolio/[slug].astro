---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Footer from '../../components/Footer.astro';
import { getAllProjects } from '../../lib/keystatic';
import { whatsappUrl } from '../../lib/whatsapp';

export async function getStaticPaths() {
  const projects = await getAllProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} — Aedifico`}>
  <Navigation minimal />
  <Breadcrumbs
    items={[
      { label: 'Homepage', href: '/' },
      { label: 'Portfolio', href: '/portfolio' },
      { label: project.title },
    ]}
  />

  <section class="container-edge flex flex-col gap-6 pb-10 pt-2 md:pb-14">
    {project.photo ? (
      <img src={project.photo} alt={project.title} class="aspect-[16/9] w-full object-cover" />
    ) : (
      <div class="aspect-[16/9] w-full bg-neutral-300"></div>
    )}

    <div class="flex flex-col gap-6 lg:flex-row lg:justify-between">
      <div class="flex flex-col gap-4 lg:max-w-[620px]">
        <h1 class="text-3xl font-semibold tracking-tight text-ink md:text-4xl">
          {project.title}
        </h1>
        <p class="text-base leading-relaxed text-muted">
          {project.detail}
        </p>
      </div>

      <div class="flex flex-col gap-5 lg:w-[280px] lg:shrink-0">
        <div class="flex flex-col gap-1.5 border-t border-border pt-4">
          <p class="text-xs font-semibold uppercase tracking-[0.8px] text-muted">Tipe</p>
          <p class="text-sm text-ink">{project.tipeLabel}</p>
        </div>
        <div class="flex flex-col gap-1.5 border-t border-border pt-4">
          <p class="text-xs font-semibold uppercase tracking-[0.8px] text-muted">Sektor</p>
          <p class="text-sm text-ink">{project.sektorLabel}</p>
        </div>
        <div class="flex flex-col gap-1.5 border-t border-border pt-4">
          <p class="text-xs font-semibold uppercase tracking-[0.8px] text-muted">Tahun</p>
          <p class="text-sm text-ink">{project.year}</p>
        </div>
        <div class="flex flex-col gap-2 border-t border-border pt-4">
          <p class="text-xs font-semibold uppercase tracking-[0.8px] text-muted">Layanan</p>
          <div class="flex flex-wrap gap-1.5">
            {project.layananLabels.map((label: string) => (
              <span class="border border-border px-2.5 py-1 text-xs text-ink">{label}</span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="mt-4 flex flex-col gap-3 border-t border-border pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-base font-medium text-ink">Tertarik dengan proyek serupa?</p>
      <a
        href={whatsappUrl(`Halo Aedifico, saya tertarik dengan proyek seperti ${project.title}.`)}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-fit items-center gap-2.5 bg-brand px-[18px] py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
      >
        Hubungi Kami (WhatsApp)
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 14L2.9 10.8C2.3 9.8 2 8.6 2 7.3C2 3.8 4.9 1 8.4 1C11.9 1 14.8 3.8 14.8 7.3C14.8 10.8 11.9 13.6 8.4 13.6C7.3 13.6 6.2 13.3 5.3 12.8L2 14Z" stroke="white" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </section>

  <Footer />
</Layout>
