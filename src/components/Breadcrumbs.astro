---
interface Item {
  label: string;
  href?: string; // omit for the current page (last item)
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="container-edge py-4">
  <ol class="flex flex-wrap items-center gap-2 text-sm">
    {items.map((item, i) => (
      <li class="flex items-center gap-2">
        {item.href ? (
          <a href={item.href} class="text-muted transition-colors hover:text-brand">{item.label}</a>
        ) : (
          <span class="font-medium text-ink">{item.label}</span>
        )}
        {i < items.length - 1 && <span class="text-border" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
