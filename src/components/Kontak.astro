---
import { whatsappUrl } from '../lib/whatsapp';
---

<section id="kontak" class="bg-ink">
  <div class="container-edge flex flex-col items-start gap-7 py-16 md:py-20 lg:py-24">
    <p class="text-xs font-semibold uppercase tracking-[1.2px] text-brand-light">
      Punya rencana proyek?
    </p>

    <h2 class="max-w-[760px] text-4xl font-bold leading-[1.1] tracking-tight text-white sm:text-5xl lg:text-[52px] lg:leading-[1.02] lg:tracking-[-1.8px]">
      Mari mulai dari kebutuhan Anda.
    </h2>

    <p class="max-w-[540px] text-base leading-relaxed text-dark-muted lg:text-[17px]">
      Sampaikan apa yang Anda inginkan atau tantangan yang ingin diselesaikan. Kami siap memberikan konsultasi awal dan estimasi yang tepat.
    </p>

    <a
      href={whatsappUrl()}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2.5 bg-white px-[18px] py-3 text-sm font-semibold text-ink transition-opacity hover:opacity-90"
    >
      Hubungi Kami (WhatsApp)
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M2 14L2.9 10.8C2.3 9.8 2 8.6 2 7.3C2 3.8 4.9 1 8.4 1C11.9 1 14.8 3.8 14.8 7.3C14.8 10.8 11.9 13.6 8.4 13.6C7.3 13.6 6.2 13.3 5.3 12.8L2 14Z" stroke="#151515" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>

    <a
      href="https://instagram.com/aedifico.id"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2.5 text-sm font-semibold text-white transition-colors hover:text-brand-light"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="1.5" y="1.5" width="17" height="17" rx="4.5" stroke="currentColor" stroke-width="1.5" />
        <circle cx="10" cy="10" r="4" stroke="currentColor" stroke-width="1.5" />
        <circle cx="14.8" cy="5.2" r="1" fill="currentColor" />
      </svg>
      @aedifico.id
    </a>
  </div>
</section>
