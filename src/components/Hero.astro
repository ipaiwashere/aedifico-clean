---
import { whatsappUrl } from '../lib/whatsapp';
---

<section class="container-edge flex flex-col items-start gap-6 py-16 md:py-20 lg:pt-[88px] lg:pb-24">
  <p class="text-xs font-semibold uppercase tracking-[1.2px] text-brand">
    Kontraktor general
  </p>

  <h1 class="text-[40px] font-bold leading-[1.1] tracking-tight text-ink sm:text-5xl md:text-6xl lg:text-[64px] lg:leading-[1.02] lg:tracking-[-2px]">
    Bangun dengan Kepastian.
  </h1>

  <p class="text-base leading-relaxed tracking-tight text-ink">
    Solusi Konstruksi Transparan dan Terencana.
  </p>

  <a
    href={whatsappUrl()}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2.5 bg-brand px-[18px] py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
  >
    Hubungi Kami (WhatsApp)
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M2 14L2.9 10.8C2.3 9.8 2 8.6 2 7.3C2 3.8 4.9 1 8.4 1C11.9 1 14.8 3.8 14.8 7.3C14.8 10.8 11.9 13.6 8.4 13.6C7.3 13.6 6.2 13.3 5.3 12.8L2 14Z" stroke="white" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>
</section>
